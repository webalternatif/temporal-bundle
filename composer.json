{
    "name": "webalternatif/temporal-bundle",
    "description": "A bundle to integrate Temporal workflows and activities into Symfony applications",
    "type": "symfony-bundle",
    "keywords": [
        "temporal",
        "workflow",
        "activity",
        "roadrunner",
        "bundle"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Web|Alternatif",
            "email": "contact@webalternatif.com",
            "homepage": "https://www.webalternatif.com"
        }
    ],
    "require": {
        "php": "8.3.* || 8.4.* || 8.5.*",
        "psr/container": "^1.1 || ^2.0",
        "symfony/clock": "^6.4 || ^7.4 || ^8.1",
        "symfony/config": "^6.4 || ^7.4 || ^8.1",
        "symfony/console": "^6.4 || ^7.4 || ^8.1",
        "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.1",
        "symfony/http-client": "^6.4 || ^7.4 || ^8.1",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.1",
        "temporal/sdk": "^2.18"
    },
    "require-dev": {
        "carthage-software/mago": "^1.59",
        "doctrine/dbal": "^4.2",
        "doctrine/orm": "^3.3",
        "doctrine/persistence": "^3.4 || ^4.0",
        "infection/infection": "^0.35.8",
        "phpunit/phpunit": "^12.5",
        "symfony/framework-bundle": "^6.4 || ^7.4 || ^8.1"
    },
    "conflict": {
        "doctrine/dbal": "<4",
        "doctrine/orm": "<3"
    },
    "suggest": {
        "doctrine/orm": "To reset Doctrine entity managers before each activity"
    },
    "scripts": {
        "analyze": "mago analyze",
        "fmt": "mago fmt",
        "fmt-check": "mago fmt --check",
        "lint": "mago lint"
    },
    "scripts-descriptions": {
        "analyze": "Run the Mago static analyzer",
        "fmt": "Format the code with Mago",
        "fmt-check": "Check that the code is formatted",
        "lint": "Run the Mago linter"
    },
    "autoload": {
        "psr-4": {
            "Webf\\TemporalBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Webf\\TemporalBundle\\": "tests/"
        }
    },
    "config": {
        "bin-dir": "bin",
        "sort-packages": true,
        "allow-plugins": {
            "carthage-software/mago": true,
            "infection/extension-installer": false,
            "php-http/discovery": false
        }
    },
    "archive": {
        "exclude": [
            "/.github/",
            "/tests/",
            "/cliff.toml",
            "/infection.json5",
            "/mago.toml",
            "/phpunit.dist.xml"
        ]
    }
}
