{
    "name": "webalternatif/temporal-bundle",
    "description": "A bundle to integrate Temporal workflows and activities into Symfony applications",
    "type": "symfony-bundle",
    "keywords": [
        "temporal",
        "workflow",
        "activity",
        "roadrunner",
        "bundle"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Web|Alternatif",
            "email": "contact@webalternatif.com",
            "homepage": "https://www.webalternatif.com"
        }
    ],
    "require": {
        "php": "8.3.* || 8.4.* || 8.5.*",
        "psr/clock": "^1.0",
        "psr/container": "^1.1 || ^2.0",
        "symfony/clock": "^6.4 || ^7.4 || ^8.1",
        "symfony/config": "^6.4.37 || ^7.4.9 || ^8.1",
        "symfony/console": "^6.4 || ^7.4 || ^8.1",
        "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.1",
        "symfony/http-client": "^6.4 || ^7.4 || ^8.1",
        "symfony/http-client-contracts": "^3.0",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.1",
        "temporal/sdk": "^2.18"
    },
    "require-dev": {
        "carthage-software/mago": "^1.59",
        "doctrine/dbal": "^3.1.4 || ^4.2",
        "doctrine/orm": "^2.10 || ^3.3",
        "doctrine/persistence": "^2.2 || ^3.4 || ^4.0",
        "infection/infection": "^0.35.8",
        "phpunit/phpunit": "^12.5",
        "symfony/cache": "^6.4 || ^7.4 || ^8.1",
        "symfony/framework-bundle": "^6.4 || ^7.4 || ^8.1"
    },
    "conflict": {
        "doctrine/dbal": "<3.1.4",
        "doctrine/orm": "<2.10"
    },
    "suggest": {
        "doctrine/orm": "To reset Doctrine entity managers before each activity",
        "symfony/cache": "To share OIDC tokens between processes (oidc.cache_pool option)"
    },
    "scripts": {
        "analyze": "mago analyze",
        "fmt": "mago fmt",
        "fmt-check": "mago fmt --check",
        "infection": "infection --threads=max",
        "lint": "mago lint",
        "phpunit": "phpunit",
        "test": [
            "@analyze",
            "@phpunit",
            "@infection",
            "@lint",
            "@fmt-check"
        ]
    },
    "scripts-descriptions": {
        "analyze": "Run the Mago static analyzer",
        "fmt": "Format the code with Mago",
        "fmt-check": "Check that the code is formatted",
        "infection": "Run mutation testing with Infection",
        "lint": "Run the Mago linter",
        "phpunit": "Run the PHPUnit test suite",
        "test": "Run every check, as the CI does"
    },
    "autoload": {
        "psr-4": {
            "Webf\\TemporalBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Webf\\TemporalBundle\\": "tests/"
        }
    },
    "config": {
        "bin-dir": "bin",
        "sort-packages": true,
        "allow-plugins": {
            "carthage-software/mago": true,
            "infection/extension-installer": false,
            "php-http/discovery": false
        }
    },
    "archive": {
        "exclude": [
            "/.github/",
            "/tests/",
            "/cliff.toml",
            "/composer-require-checker.json",
            "/infection.json5",
            "/mago.toml",
            "/phpunit.dist.xml"
        ]
    }
}
